# AdMob — copie para .env (não versionado) ou defina nas variáveis do EAS.
# true = unidades de exemplo do Google (development/preview). Nunca true em production.
EXPO_PUBLIC_ADMOB_USE_TEST_IDS=true
# App ID do AdMob (ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN). Vazio = App ID de exemplo do Google.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# Blocos antispam_banner / antispam_interstitial. Vazio = nenhuma requisição daquele formato.
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
# Opcional: IDs de dispositivo de teste, separados por vírgula.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
