    <!-- Onboarding -->
    <string name="onboarding_step1_title">Chega de chamadas indesejadas</string>
    <string name="onboarding_step1_body">Bloqueie telemarketing, golpes e robocalls antes do telefone tocar. 100% local, explicável e gratuito.</string>

    <string name="onboarding_step2_title">Seus dados ficam no seu celular</string>
    <string name="onboarding_step2_body">Sem envio de contatos ou histórico e sem cadastro obrigatório. A análise de cada chamada acontece no aparelho; a conta é opcional. Há anúncios só dentro do app, nunca durante uma chamada.</string>

    <string name="onboarding_step3_title">Ative a proteção</string>
    <string name="onboarding_step3_body">O Android pede que o AntiSpam BR seja definido como app de identificação e filtragem de chamadas. É assim que ele consegue proteger você.</string>

